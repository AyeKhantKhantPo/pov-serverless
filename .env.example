# Copy this file to .env and replace with your deployed API Gateway URLs.
# These values are used by the product service when it calls the review, rating, and detail services.

REVIEW_SERVICE_URL=https://<your-review-api-id>.execute-api.<region>.amazonaws.com
RATING_SERVICE_URL=https://<your-rating-api-id>.execute-api.<region>.amazonaws.com/rating
DETAIL_SERVICE_URL=https://<your-detail-api-id>.execute-api.<region>.amazonaws.com/detail
